{
  "manifest_version": 3,
  "name": "NOpartisan",
  "version": "0.3.1",
  "description": "Automatically filter political content on social feeds. Works offline; downloads keyword updates from GitHub on install and daily.",
  "permissions": [
    "storage",
    "alarms",
    "menus"
  ],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://x.com/*",
    "https://www.facebook.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://x.com/*",
        "https://www.facebook.com/*"
      ],
      "js": [
        "core.js",
        "x-adapter.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_title": "NOpartisan",
    "default_popup": "popup.html",
    "default_icon": "Blue NOP Tech Logo.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nopartisan@ohlongshawnson.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "keywords.json",
        "foundational.json"
      ],
      "matches": [
        "https://www.reddit.com/*",
        "https://x.com/*",
        "https://www.facebook.com/*"
      ]
    }
  ],
  "icons": {
    "1254": "Blue NOP Tech Logo.png"
  }
}
