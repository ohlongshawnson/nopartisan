[Unit]
Description=Collect and atomically publish NOpartisan political keywords
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=nopartisan
StateDirectoryMode=0700
WorkingDirectory=/opt/nopartisan-automation
LoadCredential=github-token:/etc/nopartisan/github-token
ExecStart=/usr/bin/python3 -B -m automation.publish --data /var/lib/nopartisan --token-file %d/github-token
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/nopartisan
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
